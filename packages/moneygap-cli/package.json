{
  "name": "moneygap-scan",
  "version": "0.1.1",
  "description": "MoneyGap CLI — live URL diagnostics (crawlability, schema, performance signals) plus offline project scanner.",
  "type": "module",
  "bin": {
    "moneygap-scan": "bin/moneygap-scan.js",
    "moneygap": "bin/moneygap.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "moneygap": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "moneygap",
    "cli",
    "seo",
    "aeo",
    "crawlability",
    "schema",
    "growth"
  ],
  "license": "MIT",
  "author": "vercelguard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/th3on7in3gam3r/moneygap-ai.git",
    "directory": "packages/moneygap-cli"
  },
  "homepage": "https://moneygap-ai.com",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "fast-glob": "^3.3.3",
    "ora": "^8.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "moneygap-diagnostics": "file:../moneygap-diagnostics",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
