{
  "name": "moneygap-crawler",
  "version": "0.1.0",
  "description": "MoneyGap AI Crawl Engine v2 — discovery, smart render, queue, and ScrapedPage adapter.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "require": "./dist/worker.js",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker": "node dist/worker.js"
  },
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^5.0.9",
    "normalize-url": "^8.0.1",
    "p-queue": "^8.1.0",
    "robots-parser": "^3.0.1",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "playwright": "^1.51.0",
    "pg": "^8.14.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
