{
  "name": "moneygap-diagnostics",
  "version": "0.1.0",
  "description": "Lightweight live-URL diagnostics for MoneyGap CLI and free sandbox (crawlability, schema, performance signals).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "author": "vercelguard",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "moneygap-crawler": "file:../moneygap-crawler"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
