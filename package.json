{
  "name": "moneygap-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run build --prefix packages/moneygap-crawler || true; npm run build --prefix packages/moneygap-diagnostics || true",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test:scan": "tsx --test src/lib/billing/scan-profiles.test.ts src/lib/scan/profiles.test.ts src/lib/scan/reclaim.test.ts src/lib/scan/normalize.test.ts src/lib/scan/connectivity/classify-error.test.ts src/lib/scan/connectivity/pipeline.test.ts",
    "stripe:setup": "node --import tsx --env-file=.env.local scripts/setup-stripe-catalog.ts",
    "stripe:setup:vercel": "node --import tsx --env-file=.env.local scripts/setup-stripe-catalog.ts --vercel"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.3",
    "@mendable/firecrawl-js": "^4.31.1",
    "@neondatabase/serverless": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "moneygap-crawler": "file:packages/moneygap-crawler",
    "moneygap-diagnostics": "file:packages/moneygap-diagnostics",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "openai": "^7.2.0",
    "pdfkit": "^0.19.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
